@model IEnumerable<Website.Models.DTOs.Portfolios.PortfolioDetailsDto>

@{
    ViewData["Title"] = "Portfolios";
}

<h1>@ViewData["Title"]</h1>

<div class="container">
    <div class="row">
        <div class="col">
            <a asp-action="Create" class="btn btn-success">Create New Portfolio</a>
        </div>
        <div class="col-4">
            <form method="post" asp-action="Search" asp-controller="Property">
                <div class="input-group">
                    <input type="text" class="form-control" id="searchTerm" value="@ViewBag.CurrentFilter"
                    name="searchTerm" required placeholder="Search all properties"/>
                    <span class="input-group-btn" style="width:0;">
                        <button type="submit" class="btn btn-primary">Search</button>
                        </span>
                </div>
                
            </form>
        </div>
    </div>
</div>

<table class="table table-hover" id="portfolioIndexTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumberOfProperties)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalPropertyValue)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GrossIncome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedDate)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section Scripts {
    <script src="~/js/Portfolios/index.js" asp-append-version="true"></script>
}